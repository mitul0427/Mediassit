# ==========================================
# Project Root .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
*.env
*.env.*
!.env.example

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production builds & artifacts
dist/
dist-ssr/
build/
*.local

# Database files
*.db
*.sqlite
*.sqlite3
medical_data.db

# User uploads & temporary files
uploads/*
!uploads/.gitkeep
medical-backend/uploads/*
!medical-backend/uploads/.gitkeep

# Logs and scratch files
logs/
*.log
out.txt

# Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
